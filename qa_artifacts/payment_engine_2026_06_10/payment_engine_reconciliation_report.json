  "implemented_formula_after_fix": [
    {
      "component": "Base CPT Medicare estimate",
      "formula": "estimated_medicare_payment = total_rvu * 33.4009",
      "source": "cpt_database.json"
    },
    {
      "component": "Search",
      "formula": "display estimated_medicare_payment from cpt_database.json"
    },
    {
      "component": "Case Builder single line",
      "formula": "line.pay = line.basePayment from cpt_database.json"
    },
    {
      "component": "Case Builder facility multi-procedure",
      "formula": "primary line basePayment at 100%; secondary non-add-on lines basePayment * 0.5; add-on lines 100%; bilateral uses basePayment * 1.5 before rank/MPPR logic"
    },
    {
      "component": "wRVU total",
      "formula": "sum effective work RVUs; separate from reimbursement estimate"
    }
  ],
  "hardcoded_conversion_factors_after_fix": [
    {
      "file": "index.html",
      "constant": "MEDICARE_CONVERSION_FACTOR",
      "value": 33.4009,
      "usage": "fallback only when cpt_database estimated_medicare_payment is absent; also labels CMS CF in exports"
    }
  ],
